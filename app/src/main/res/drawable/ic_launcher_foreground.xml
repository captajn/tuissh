<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
      Tui SSH mark: a terminal prompt `>_` on a dark slab.

      The chevron is drawn as two thick strokes rather than a filled triangle so it
      stays legible at 48dp and does not read as a play button. The underscore is a
      rounded bar, sitting on the same optical baseline as the chevron's tip.
    -->
    <path
        android:fillColor="#101820"
        android:pathData="M0,0h108v108h-108z" />

    <!-- > chevron -->
    <path
        android:strokeColor="#3DDC97"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M28,34 L48,54 L28,74" />

    <!-- _ cursor bar -->
    <path
        android:strokeColor="#E8EEF4"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:pathData="M58,76 L82,76" />
</vector>
